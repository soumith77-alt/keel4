# Contact form destination.
#
# NEXT_PUBLIC_ means this value is INLINED INTO THE JAVASCRIPT BUNDLE at build
# time and is readable by anyone who views source. That is fine here — a form
# endpoint is a public "send me a message" address, the same way the email in
# the footer is. Never put an API key or any secret behind a NEXT_PUBLIC_ name.
#
# It lives in a committed file rather than in the Cloudflare Pages dashboard for
# two reasons: it is not a secret, and the site is a static export, so this is
# read at BUILD time. Keeping it in the repo means a fresh clone builds a
# working form instead of silently falling back to mailto.
#
# When this is unset, components/ContactForm.tsx falls back to opening the
# visitor's mail client pre-composed to hello@saykeel.com, and the success
# message changes to say so. Both paths deliver; this one converts better.
NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/mqpzpbol
